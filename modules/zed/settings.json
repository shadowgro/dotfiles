// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "auto_update": false,
  "cli_default_open_behavior": "existing_window",
  "default_open_behavior": "new_window",
  "cursor_blink": true,
  "cursor_shape": "block",
  "cursor_animation": {
    "enabled": true
  },
  "multi_cursor_modifier": "cmd_or_ctrl",
  "text_rendering_mode": "platform_default",
  "inline_code_actions": true,
  "relative_line_numbers": "disabled",
  "soft_wrap": "editor_width",
  "gutter": {
    "git_gutter_width": "default",
    "folds": false,
    "min_line_number_digits": 0,
    "bookmarks": false,
    "breakpoints": false,
    "runnables": false,
    "line_numbers": true
  },
  "project_panel": {
    "dock": "left"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "ui_font_size": 16,
  "ui_font_family": "Comfortaa",
  "ui_font_weight": 400, // Font weight in standard CSS units from 100 to 900.
  "buffer_font_size": 18,
  "buffer_font_family": "Maple Mono NF", // Font name for editor buffer
  "buffer_font_weight": 400,              // Font weight in CSS units [100-900]
  "buffer_line_height": "standard",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Ayu Dark",
  },
  // Terminal Font Settings
  "terminal": {
    "font_family": "Maple Mono NF",
    "font_size": 15,
    // Terminal line height: comfortable (1.618), standard(1.3) or `{ "custom": 2 }`
    "line_height": "standard",
  },
  // "active_pane_modifiers": {
  //     // Inset border size of the active pane, in pixels.
  //     "border_size": 0.0,
  //     // Opacity of the inactive panes. 0 means transparent, 1 means opaque.
  //     "inactive_opacity": 0.3
  //   },
    "theme_overrides": {
        "Ayu Dark": {
          "background.appearance": "transparent",
          "text": "#D8DEE9ff",
          "border": "#2C2C2C00",
          "border.variant": "#2C2C2C00",
          "border.focused": "#2C2C2C4d",
          "border.selected": "#2C2C2C00",
          "border.disabled": "#2C2C2C00",
          "elevated_surface.background": "#2C2C2Cff",
          "surface.background": "#2C2C2C4d",
          "background": "#2C2C2C4D",
          "element.background": "#2C2C2C00",
          "element.hover": "#2C2C2C4D",
          "element.active": "#2C2C2C00",
          "element.selected": "#2C2C2C4D",
          "element.disabled": "#00000000",
          "ghost_element.hover": "#2C2C2C4D",
          "ghost_element.active": "#2C2C2C4D",
          "ghost_element.selected": "#2C2C2C4D",
          "ghost_element.disabled": "#2C2C2C66",
          "status_bar.background": "#2C2C2C4d",
          "title_bar.background": "#2C2C2C4D",
          "title_bar.inactive_background": "#2C2C2C4D",
          "toolbar.background": "#2C2C2C00",
          "tab_bar.background": "#2F343E00",
          "tab.inactive_background": "#2C2C2C00",
          "tab.active_background": "#2C2C2C4D",
          "panel.background": "#2C2C2C00",
          "panel.focused_border": "#2C2C2C4D",
          "pane.focused_border": "#2C2C2C4D",
          "scrollbar.thumb.background": "#2C2C2C4D",
          "scrollbar.thumb.hover_background": "#2C2C2C66",
          "scrollbar.track.border": "#2C2C2C00",
          "editor.background": "#2C2C2C00",
          "editor.gutter.background": "#2C2C2C00",
          "editor.subheader.background": "#2C2C2C4D",
          "editor.active_line.background": "#2C2C2C4D",
          "editor.highlighted_line.background": "#2C2C2C4D",
          "editor.line_number": "#8a8986ff",
          "editor.active_line_number": "#D8DEE9ff",
          "editor.hover_line_number": "#BDBDBDFF",
          "info": "#BDBDBDFF",
          "panel.indent_guide": "#2C2C2C4D",
          "scrollbar.thumb.active_background": "#2C2C2C66",
          "panel.overlay_background": "#2C2C2CFF",
          "panel.overlay_hover": "#2C2C2CFF",
          "editor.indent_guide": "#2C2C2C4D",
          "minimap.thumb.background": "#2C2C2C4D",
          "minimap.thumb.hover_background": "#2C2C2C66",
          "minimap.thumb.active_background": "#2C2C2C66",
          "terminal.background": "#2C2C2C00",
          "players": [
            {
              "cursor": "#d8dee9",
              "background": "#597ab680",
              "selection": "#5a5a5a66"
            },
            {
              "cursor": "#5a5a5a",
              "background": "#2c212180",
              "selection": "#2c212160"
            }
          ],
        }
      }
}
