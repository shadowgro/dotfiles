// ReaMix Beat Mapper Tool by Damien Stewart (Hypex)

// November 24, 2016. V1.5.

// Beat Splitter.

// Semi-automatic beat mapper. Takes a base BPM as a reference with a 
// percentage of variance to work with and amount of beats to cover
// per tempo marker. Will then scan over selected items in track 
// starting from edit cursor or time selection and mark tempo changes
// to the nearest transient within the BPM range calculated.

// Inputs:
// Base BPM Reference:    Base BPM as reference value.
// Variance (Percentage): Amount that BPM is expected to vary either way.
// Beats per Marker:      Number of beats to cover per tempo marker.
// Allowance (For errors) Number of beat misses to allow for.

// Output:
// Hopefully a fully tempo mapped selection of music! :-)


@import ./ReaMix Beat Core.eel

function BeatMark()
(
	(Time > 0) ?
	(
		Item = SplitMediaItem(Item, Time);
		(!Item) ? NextTime = EndTime;
	);
);
				
function main() 
(
	BeatMap("ReaMix Beat Splitter Tool");
);

main();
