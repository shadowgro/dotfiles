      <VIDEO_EFFECT "Video processor" ""
        <CODE
          |//Brightness/Contrast
          |//@param1:brightness 'brightness' 0.0 -2 2
          |//@param2:contrast 'contrast' 1.0 0 2
          |//@param4:brightness2 'brightness pre' 0.0 -1 1
          |//@param5:contrast2 'contrast big' 1.0 -50 50
          |//@param7:saturation 'saturation-ish' 1.0 -10 10
          |
          |(cv=abs(contrast*contrast2)) > 1 ? cv = (cv-1)*4 + 1;
          |cv=((2^cv)-1) * sign(contrast*contrast2);
          |i=tab=0;
          |loop(256,
          |  v = i/256;
          |  tab[i]=(v-0.5+brightness2)*cv+0.5+brightness;
          |  tab[i+256]=tab[i+512]=0.5 + (v-0.5)*saturation;
          |  i+=1;
          |);
          |
          |input_info(0,project_w,project_h) || tab[0] > 0 ? (
          |  colorspace!='YUY2' ? colorspace='YV12';
          |  gfx_blit(0);
          |  gfx_procrect(0,0,project_w,project_h,tab);
          |);
        >
